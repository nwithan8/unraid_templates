<?xml version="1.0"?>
<Container version="2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://raw.githubusercontent.com/nwithan8/unraid_templates/main/templates/template_schema.xsd template_schema.xsd">
    <Name>Samba</Name>
    <Repository>dockurr/samba:latest</Repository>
    <Registry>https://hub.docker.com/r/dockurr/samba</Registry>
    <Branch>
        <Tag>latest</Tag>
        <TagDescription>Latest stable release</TagDescription>
    </Branch>
    <Network>bridge</Network>
    <Privileged>false</Privileged>
    <Support>https://github.com/dockur/samba/issues</Support>
    <Project>https://github.com/dockur/samba</Project>
    <Overview>
        Set up an SMB networking server.
    </Overview>
    <Beta>False</Beta>
    <Category>Productivity: Tools: Other: Status:Stable</Category>
    <ExtraSearchTerms>samba smb share files network</ExtraSearchTerms>
    <Icon>https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/samba-icon.png</Icon>
    <Banner>https://raw.githubusercontent.com/dockur/samba/master/.github/logo.png</Banner>
    <TemplateURL>https://raw.githubusercontent.com/nwithan8/unraid_templates/main/templates/samba.xml</TemplateURL>
    <Maintainer>
        <WebPage>https://github.com/nwithan8</WebPage>
    </Maintainer>
    <Changes>
        ### 2026-10-26

        Initial release
    </Changes>
    <Config Name="Port" Target="445" Default="445" Mode="tcp" Description="Container Port: 445" Type="Port" Display="always-hide" Required="true" Mask="false">445</Config>
    <Config Name="Share Name" Target="NAME" Default="Shared" Description="" Type="Variable" Display="always-hide" Required="true" Mask="false"/>
    <Config Name="Share Username" Target="USER" Default="samba" Description="" Type="Variable" Display="always-hide" Required="true" Mask="false"/>
    <Config Name="Share Password" Target="PASS" Default="" Description="" Type="Variable" Display="always-hide" Required="true" Mask="true"/>
    <Config Name="Data Path" Target="/shared" Default="/mnt/user/appdata/samba/data" Description="Path to the stored data" Type="Path" Display="advanced-hide" Required="true" Mask="false">/mnt/user/appdata/samba/data</Config>
</Container>
