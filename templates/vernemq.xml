<?xml version="1.0"?>
<Container version="2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://raw.githubusercontent.com/nwithan8/unraid_templates/main/templates/template_schema.xsd template_schema.xsd">
    <Name>VerneMQ</Name>
    <Repository>vernemq/vernemq:latest</Repository>
    <Registry>https://hub.docker.com/r/vernemq/vernemq</Registry>
    <Branch>
        <Tag>latest</Tag>
        <TagDescription>Latest stable release</TagDescription>
    </Branch>
    <Network>bridge</Network>
    <Privileged>false</Privileged>
    <Support>https://docs.vernemq.com/</Support>
    <Project>https://vernemq.com/</Project>
    <Overview>
        VerneMQ is a high-performance, distributed MQTT message broker. It scales horizontally and vertically on commodity hardware to support a high number of concurrent publishers and consumers while maintaining low latency and fault tolerance. VerneMQ is the reliable message hub for your IoT platform or smart products.    </Overview>
    <Beta>False</Beta>
    <Category>Productivity: Tools: Other: Status:Stable</Category>
    <ExtraSearchTerms>network mqtt broker iot</ExtraSearchTerms>
    <Icon>https://vernemq.com/images/vernemq-hero-logo.png</Icon>
    <TemplateURL>https://raw.githubusercontent.com/nwithan8/unraid_templates/main/templates/vernemq.xml</TemplateURL>
    <Maintainer>
        <WebPage>https://github.com/nwithan8</WebPage>
    </Maintainer>
    <Changes>
        ### 2026-10-26

        Initial release
    </Changes>
    <Config Name="MQTT Port" Target="1883" Default="1883" Mode="tcp" Description="Container Port: 1883" Type="Port" Display="always-hide" Required="true" Mask="false">1883</Config>
    <Config Name="MQTT WS Port" Target="8080" Default="8080" Mode="tcp" Description="Container Port: 8080" Type="Port" Display="always-hide" Required="true" Mask="false">8080</Config>
    <Config Name="Accept EULA" Target="DOCKER_VERNEMQ_ACCEPT_EULA" Default="no|yes" Description="Accept EULA`" Type="Variable" Display="always-hide" Required="true" Mask="false"/>
    <Config Name="Allow Anonymous" Target="DOCKER_VERNEMQ_ALLOW_ANONYMOUS" Default="off|on" Description="Allow anonymous (no credentials) users`" Type="Variable" Display="always-hide" Required="true" Mask="false"/>
</Container>
