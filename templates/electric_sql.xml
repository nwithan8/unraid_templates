<?xml version="1.0"?>
<Container version="2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://raw.githubusercontent.com/nwithan8/unraid_templates/main/templates/template_schema.xsd template_schema.xsd">
    <Name>electric</Name>
    <Repository>electricsql/electric:latest</Repository>
    <Registry>https://hub.docker.com/r/electricsql/electric</Registry>
    <Branch>
        <Tag>latest</Tag>
        <TagDescription>Latest stable release</TagDescription>
    </Branch>
    <Network>bridge</Network>
    <WebUI>http://[IP]:[PORT:3000]/</WebUI>
    <Privileged>false</Privileged>
    <Support>https://electric.ax/</Support>
    <Project>https://electric.ax/</Project>
    <Overview>
        Real-time sync for Postgres.
    </Overview>
    <Beta>False</Beta>
    <Category>Productivity: Tools: Other: Status:Stable</Category>
    <ExtraSearchTerms>sql web browser explorer data database mysql postgres</ExtraSearchTerms>
    <Icon>https://raw.githubusercontent.com/electric-sql/meta/main/identity/ElectricSQL-logo-next.svg</Icon>
    <TemplateURL>https://raw.githubusercontent.com/nwithan8/unraid_templates/main/templates/electric_sql.xml</TemplateURL>
    <Maintainer>
        <WebPage>https://github.com/nwithan8</WebPage>
    </Maintainer>
    <Changes>
        ### 2026-10-26

        Initial release
    </Changes>
    <Requires>
        Requires a separate Postgres database.
    </Requires>
    <Config Name="Web UI Port" Target="3000" Default="3000" Mode="tcp" Description="Container Port: 3000" Type="Port" Display="always-hide" Required="true" Mask="false">3000</Config>
    <Config Name="Postgres Database URL" Target="DATABASE_URL" Default="" Description="Connection string to a Postgres database" Type="Variable" Display="always-hide" Required="true" Mask="true"/>
    <Config Name="Insecure Mode" Target="ELECTRIC_INSECURE" Default="false|true" Description="Insecure mode for API for development" Type="Variable" Display="always-hide" Required="true" Mask="false"/>
</Container>
